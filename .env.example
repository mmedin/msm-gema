# ==============================================================================
# GEMA — Variables de Entorno de Configuración
# Municipalidad de General San Martín
# ==============================================================================
# Copie este archivo como .env y reemplace TODOS los valores marcados con
# "CAMBIAR_" por valores propios antes de ejecutar `docker compose up`.
# Docker Compose NO arrancará si POSTGRES_PASSWORD y JWT_SECRET no están definidos.

# --- BASE DE DATOS POSTGRESQL ---
POSTGRES_DB=msm_crisis
POSTGRES_USER=crisis_user
# ⚠️ OBLIGATORIO: defina una contraseña segura para PostgreSQL
POSTGRES_PASSWORD=CAMBIAR_contraseña_segura_postgres

# --- BACKEND EXPRESS ---
PORT=4000
BACKEND_PORT=4000
# ⚠️ OBLIGATORIO: defina un secreto aleatorio para firmar tokens JWT (mínimo 32 caracteres)
# Puede generar uno con: openssl rand -base64 48
JWT_SECRET=CAMBIAR_secreto_jwt_aleatorio_min_32_chars
FRONTEND_URL=http://localhost:3000

# --- RATE LIMITING ---
# RATE_LIMIT_LOGIN_WINDOW_MS=60000
# RATE_LIMIT_LOGIN_MAX=10

# --- FRONTEND REACT / NGINX ---
FRONTEND_PORT=3000
# Por defecto se usa '/api' relativo para que Nginx rutee internamente tanto en PC,
# celular en red local (Wi-Fi) o dominio público sin problemas de CORS ni IPs fijas.
VITE_API_URL=/api


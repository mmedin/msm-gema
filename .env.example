# ==============================================================================
# GEMA — Variables de Entorno de Configuración
# Municipalidad de General San Martín
# ==============================================================================
# Copie este archivo como .env para personalizar la configuración en producción o Coolify.
# En entorno de desarrollo local, Docker Compose cuenta con valores por defecto funcionales.

# --- BASE DE DATOS POSTGRESQL ---
POSTGRES_DB=msm_crisis
POSTGRES_USER=crisis_user
POSTGRES_PASSWORD=crisis_secret_2026

# --- BACKEND EXPRESS ---
PORT=4000
BACKEND_PORT=4000
JWT_SECRET=super_secreto_para_jwt_crisis_san_martin_2026
FRONTEND_URL=http://localhost:3000

# --- FRONTEND REACT / NGINX ---
FRONTEND_PORT=3000
# Por defecto se usa '/api' relativo para que Nginx rutee internamente tanto en PC,
# celular en red local (Wi-Fi) o dominio público sin problemas de CORS ni IPs fijas.
VITE_API_URL=/api
